{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commit": false,
    "tag": false,
    "push": false,
    "tagName": "v${version}",
    "tagAnnotation": "v${version}"
  },
  "github": false,
  "npm": {
    "ignoreVersion": true,
    "publish": false,
    "skipChecks": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits",
        "bumpStrict": true
      },
      "infile": false
    }
  }
}
