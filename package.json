{
  "name": "@inkronik/node-sdk",
  "version": "1.2.3",
  "description": "Inkronik telemetry SDK for Node.js, Bun, Express, and NestJS applications.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "auto": [
        "dist/auto.d.ts"
      ],
      "express": [
        "dist/express/index.d.ts"
      ],
      "nest": [
        "dist/nest/index.d.ts"
      ],
      "register": [
        "dist/register.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/register.js",
    "./dist/cjs/register.cjs"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/cjs/auto.d.cts",
        "default": "./dist/cjs/auto.cjs"
      },
      "default": "./dist/auto.js"
    },
    "./express": {
      "import": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "require": {
        "types": "./dist/cjs/express/index.d.cts",
        "default": "./dist/cjs/express/index.cjs"
      },
      "default": "./dist/express/index.js"
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/nest/index.d.cts",
        "default": "./dist/cjs/nest/index.cjs"
      },
      "default": "./dist/nest/index.js"
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/cjs/register.d.cts",
        "default": "./dist/cjs/register.cjs"
      },
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:js && bun run build:types && bun run build:types:cjs && bun run check:exports && bun run check:runtime && bun run check:types:consumers",
    "build:clean": "bun scripts/clean.ts",
    "build:js": "bun run build:js:esm && bun run build:js:cjs",
    "build:js:esm": "bun build src/index.ts src/auto.ts src/express/index.ts src/nest/index.ts src/register.ts --root=src --outdir=dist --target=node --format=esm --splitting --sourcemap=linked --external=@nestjs/common --external=postgres --external=rxjs --allow-unresolved='<empty>'",
    "build:js:cjs": "bun build src/index.ts src/auto.ts src/express/index.ts src/nest/index.ts src/register.ts --root=src --outdir=dist/cjs --target=node --format=cjs --entry-naming='[dir]/[name].cjs' --sourcemap=linked --external=@nestjs/common --external=postgres --external=rxjs --allow-unresolved='<empty>'",
    "build:types": "bun tsc --project tsconfig.build.json",
    "build:types:cjs": "node scripts/build-cjs-declarations.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:format": "prettier --check .",
    "check:lint": "eslint src",
    "check:runtime": "node scripts/check-package-runtime.mjs cjs && node scripts/check-package-runtime.mjs esm && bun scripts/check-package-runtime.mjs cjs && bun scripts/check-package-runtime.mjs esm",
    "check:types:consumers": "bun tsc --noEmit --project scripts/fixtures/tsconfig.package-consumers.json && node scripts/check-legacy-types.mjs",
    "pack:check": "npm pack --dry-run",
    "release:version": "release-it --release-version --ci",
    "test": "bun test ./src",
    "typecheck": "bun tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkronik/node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/inkronik/node-sdk/issues"
  },
  "homepage": "https://github.com/inkronik/node-sdk#readme",
  "keywords": [
    "inkronik",
    "observability",
    "sdk",
    "telemetry",
    "tracing",
    "monitoring",
    "nodejs",
    "bun",
    "express",
    "nestjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.17",
    "pg": "8.20.0",
    "postgres": "3.4.8",
    "rxjs": "7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.1.17",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/bun": "1.3.11",
    "brace-expansion": "1.1.18",
    "eslint": "9.39.4",
    "eslint-config-codemask": "2.2.1",
    "ip-address": "10.4.0",
    "pg": "8.20.0",
    "postgres": "3.4.8",
    "prettier": "3.8.1",
    "release-it": "21.0.1",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
