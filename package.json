{
  "name": "@inkronik/node-sdk",
  "version": "1.1.0",
  "description": "Inkronik telemetry SDK for Node.js, Bun, Express, and NestJS applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/register.js"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "import": "./dist/nest/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun run build:clean && bun run build:js && bun run build:types",
    "build:clean": "bun scripts/clean.ts",
    "build:js": "bun build src/index.ts src/auto.ts src/express/index.ts src/nest/index.ts src/register.ts --root=src --outdir=dist --target=node --format=esm --splitting --sourcemap=linked --external=@nestjs/common --external=postgres --external=rxjs --allow-unresolved='<empty>'",
    "build:types": "bun tsc --project tsconfig.build.json",
    "check:format": "prettier --check .",
    "check:lint": "eslint src",
    "pack:check": "npm pack --dry-run",
    "release": "release-it",
    "test": "bun test ./src",
    "typecheck": "bun tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkronik/node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/inkronik/node-sdk/issues"
  },
  "homepage": "https://github.com/inkronik/node-sdk#readme",
  "keywords": [
    "inkronik",
    "observability",
    "sdk",
    "telemetry",
    "tracing",
    "monitoring",
    "nodejs",
    "bun",
    "express",
    "nestjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.17",
    "postgres": "3.4.8",
    "rxjs": "7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.1.17",
    "@release-it/conventional-changelog": "11.0.1",
    "@types/bun": "1.3.11",
    "eslint": "9.39.4",
    "eslint-config-codemask": "2.2.1",
    "postgres": "3.4.8",
    "prettier": "3.8.1",
    "release-it": "20.2.1",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.14"
}
