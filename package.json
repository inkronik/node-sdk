{
  "name": "@inkronik/node-sdk",
  "version": "1.2.3",
  "description": "Inkronik telemetry SDK for Node.js, Bun, Next.js, Express, and NestJS applications.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "auto": [
        "dist/auto.d.ts"
      ],
      "init": [
        "dist/register.d.ts"
      ],
      "express": [
        "dist/express/index.d.ts"
      ],
      "graphql": [
        "dist/graphql/index.d.ts"
      ],
      "nest": [
        "dist/nest/index.d.ts"
      ],
      "next": [
        "dist/next/index.d.ts"
      ],
      "register": [
        "dist/register.d.ts"
      ]
    }
  },
  "sideEffects": [
    "./dist/register.js",
    "./dist/cjs/register.cjs"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/cjs/auto.d.cts",
        "default": "./dist/cjs/auto.cjs"
      },
      "default": "./dist/auto.js"
    },
    "./express": {
      "import": {
        "types": "./dist/express/index.d.ts",
        "default": "./dist/express/index.js"
      },
      "require": {
        "types": "./dist/cjs/express/index.d.cts",
        "default": "./dist/cjs/express/index.cjs"
      },
      "default": "./dist/express/index.js"
    },
    "./graphql": {
      "import": {
        "types": "./dist/graphql/index.d.ts",
        "default": "./dist/graphql/index.js"
      },
      "require": {
        "types": "./dist/cjs/graphql/index.d.cts",
        "default": "./dist/cjs/graphql/index.cjs"
      },
      "default": "./dist/graphql/index.js"
    },
    "./init": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/cjs/register.d.cts",
        "default": "./dist/cjs/register.cjs"
      },
      "default": "./dist/register.js"
    },
    "./nest": {
      "import": {
        "types": "./dist/nest/index.d.ts",
        "default": "./dist/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/nest/index.d.cts",
        "default": "./dist/cjs/nest/index.cjs"
      },
      "default": "./dist/nest/index.js"
    },
    "./next": {
      "import": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "require": {
        "types": "./dist/cjs/next/index.d.cts",
        "default": "./dist/cjs/next/index.cjs"
      },
      "default": "./dist/next/index.js"
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/cjs/register.d.cts",
        "default": "./dist/cjs/register.cjs"
      },
      "default": "./dist/register.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "benchmark:memory": "bun --expose-gc scripts/memory-benchmark.ts",
    "build": "bun run build:clean && bun run build:js && bun run build:types && bun run build:types:cjs && bun run check:exports && bun run check:runtime && bun run check:types:consumers && bun run check:next",
    "build:clean": "bun scripts/clean.ts",
    "build:js": "bun run build:js:esm && bun run build:js:cjs",
    "build:js:esm": "bun build src/index.ts src/auto.ts src/express/index.ts src/graphql/index.ts src/nest/index.ts src/next/index.ts src/register.ts --root=src --outdir=dist --target=node --format=esm --splitting --sourcemap=linked --external=@nestjs/common --external=@opentelemetry/api --external=@opentelemetry/resources --external=@opentelemetry/sdk-trace-base --external=@opentelemetry/sdk-trace-node --external=@opentelemetry/semantic-conventions --external=graphql --external=postgres --external=rxjs --allow-unresolved='<empty>'",
    "build:js:cjs": "bun build src/index.ts src/auto.ts src/express/index.ts src/graphql/index.ts src/nest/index.ts src/next/index.ts src/register.ts --root=src --outdir=dist/cjs --target=node --format=cjs --entry-naming='[dir]/[name].cjs' --sourcemap=linked --external=@nestjs/common --external=@opentelemetry/api --external=@opentelemetry/resources --external=@opentelemetry/sdk-trace-base --external=@opentelemetry/sdk-trace-node --external=@opentelemetry/semantic-conventions --external=graphql --external=postgres --external=rxjs --allow-unresolved='<empty>'",
    "build:types": "bun tsc --project tsconfig.build.json",
    "build:types:cjs": "node scripts/build-cjs-declarations.mjs",
    "check:exports": "node scripts/check-package-exports.mjs",
    "check:format": "prettier --check .",
    "check:lint": "eslint src scripts/*.ts --max-warnings 0",
    "check:next": "next build scripts/fixtures/next-app && node scripts/check-next-runtime.mjs",
    "check:runtime": "node scripts/check-package-runtime.mjs cjs && node scripts/check-package-runtime.mjs esm && bun scripts/check-package-runtime.mjs cjs && bun scripts/check-package-runtime.mjs esm && node scripts/check-package-init-runtime.mjs cjs && node scripts/check-package-init-runtime.mjs esm && bun scripts/check-package-init-runtime.mjs cjs && bun scripts/check-package-init-runtime.mjs esm",
    "check:types:consumers": "bun tsc --noEmit --project scripts/fixtures/tsconfig.package-consumers.json && node scripts/check-legacy-types.mjs",
    "pack:check": "npm pack --dry-run",
    "release:version": "release-it --release-version --ci",
    "test": "bun test ./src",
    "typecheck": "bun tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkronik/node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/inkronik/node-sdk/issues"
  },
  "homepage": "https://github.com/inkronik/node-sdk#readme",
  "keywords": [
    "inkronik",
    "observability",
    "sdk",
    "telemetry",
    "tracing",
    "monitoring",
    "nodejs",
    "bun",
    "express",
    "nestjs",
    "nextjs"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@nestjs/common": "11.1.29",
    "graphql": "16.11.0",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "rxjs": "7.8.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "postgres": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.1.29",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "axios": "1.18.1",
    "brace-expansion": "5.0.9",
    "eslint": "10.8.1",
    "eslint-config-codemask": "2.2.1",
    "graphql": "16.11.0",
    "ip-address": "10.5.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "release-it": "21.0.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  }
}
